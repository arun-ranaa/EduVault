# Server
PORT=5000
HOST=127.0.0.1
NODE_ENV=production

# Database (Amazon RDS MySQL with TLS)
DATABASE_URL="mysql://username:password@your-rds-endpoint:3306/eduvault?sslaccept=strict"

# JWT (Generate a strong 64+ hex char secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-at-least-32-character-cryptographically-random-secret
JWT_EXPIRES_IN=1d

# AWS S3 (Prefer EC2 IAM Instance Role in production instead of static access keys)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=your-eduvault-bucket-name

# Frontend URL & CORS (HTTPS only in production)
FRONTEND_URL=https://your-domain.example.com
CORS_ORIGINS=https://your-domain.example.com

# Email (SMTP / Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Admin Seeding (Required only when creating/resetting initial admin via prisma:seed)
ADMIN_SEED_EMAIL=admin@eduvault.com
ADMIN_SEED_PASSWORD=

# File Upload & Storage Limits
MAX_VAULT_STORAGE=5368709120
UPLOAD_PRESIGNED_URL_EXPIRY=300
DOWNLOAD_PRESIGNED_URL_EXPIRY=120
